# ============================================================
# ZakaPro — Modèle de configuration (AUCUNE VALEUR RÉELLE)
# Copiez ce fichier en `.env` pour `vercel dev`, et déclarez
# les vraies valeurs dans Vercel → Settings → Environment.
# Le fichier `.env` réel est ignoré par Git (.gitignore).
# ============================================================

# Connexion Neon PostgreSQL (URL pooler, sans channel_binding)
DATABASE_URL=

# Compte Gmail utilisé pour les e-mails de vérification
EMAIL_USER=
EMAIL_PASS=

# Secret de signature des JWT de session (chaîne longue aléatoire)
JWT_SECRET=

# URL publique déployée (liens dans les e-mails)
APP_URL="https://votre-projet.vercel.app"

# Clé secrète du téléphone/écouteur qui transmet les SMS d'abonnement
SMS_LISTENER_SECRET=

# Coordonnées officielles pour activer un abonnement ZakaPro
ADMIN_MONCASH_PHONE=50944617600
ADMIN_NATCASH_PHONE=50940243434
ADMIN_MERCHANT_NAME="Cleef O. JOSEPH"
